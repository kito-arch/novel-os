    "ai": "^7.0.99",
    "dotenv-cli": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.1",
    "next": "16.3.5",
    "postgres": "^3.4.9",
    "react": "19.2.8",
