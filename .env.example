# Speech-to-text
# assemblyai | mock (dev default)
STT_PROVIDER=mock
STT_API_KEY=

# LLM
# openai | anthropic | mock (test-only; real loops need openai/anthropic)
LLM_PROVIDER=openai
LLM_CHEAP_MODEL=gpt-5-nano
LLM_STANDARD_MODEL=gpt-5-mini
LLM_BEST_MODEL=gpt-5-pro
LLM_API_KEY=

# Database (Postgres / Drizzle)
DATABASE_URL=

# Job queue (AWS SQS — fully managed, replaces Redis/BullMQ)
AWS_REGION=
SQS_QUEUE_URL=

# Webhook auth (AssemblyAI STT callbacks) — secret echoed back by the provider
WEBHOOK_SECRET=