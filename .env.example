# Speech-to-text
# assemblyai | mock (dev default)
STT_PROVIDER=mock
STT_API_KEY=

# LLM
# openai | anthropic | mock (test-only; real loops need openai/anthropic)
LLM_PROVIDER=openai
LLM_CHEAP_MODEL=gpt-5-nano
LLM_STANDARD_MODEL=gpt-5-mini
LLM_BEST_MODEL=gpt-5-pro
LLM_API_KEY=

# Database (Postgres / Drizzle)
DATABASE_URL=

# Job queues (AWS SQS — separate queues so transcription and extraction scale independently)
# Transcription: Lambda reserved concurrency must equal ASSEMBLYAI_MAX_CONCURRENT (5)
# Extraction: tune reserved concurrency to your LLM provider's rate limit (default 10)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_TRANSCRIPTION_QUEUE_URL=
SQS_EXTRACTION_QUEUE_URL=

# Media storage (AWS S3 — required in production; omit to fall back to local public/uploads in dev)
S3_BUCKET=

# Webhook auth (AssemblyAI STT callbacks) — secret echoed back by the provider
WEBHOOK_SECRET=

# Auth — sign JWTs for user sessions (min 32 chars; required in production)
JWT_SECRET=